# ---------------------------------------------------------------------------
# Screenplay Vault — Pi / local-network environment
# ---------------------------------------------------------------------------
# Copy this file to packages/backend/.env.pi and fill in your values.
# Run the server from the repo root:
#   node --env-file=packages/backend/.env.pi packages/backend/dist/pi/server.js

# Must be "development" to bypass Cognito auth and use the local SQLite store.
NODE_ENV=development

# Any stable string that identifies you as the single user of this instance.
# All your data will be stored under this key in the local SQLite database.
DEV_USER_ID=peter

# Port the server listens on (default: 8080).
# PORT=8080
