# Copy this file to packages/backend/.env.local and fill in the values.
#
# This file is used by the local dev server (pnpm dev:backend).
# It is NOT used in production — production config comes from AWS SSM / Lambda env.

# The user ID to inject as the authenticated user in development.
# Can be any string — it becomes the `userId` in all handler contexts.
NODE_ENV=development
DEV_USER_ID=local-dev-user

# Secret used to derive the S3 object key for the user's database.
# Must be at least 32 characters. Any random string works locally.
DB_HMAC_SECRET=change-me-to-at-least-32-chars-long!!
